# Local development uses the real Firestore emulator, without cloud credentials.
STORAGE_BACKEND=firestore
FIREBASE_PROJECT_ID=demo-amazego
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# For cloud Firestore: set your project ID and REMOVE FIRESTORE_EMULATOR_HOST.
# Use existing Application Default Credentials, or a server-only service account:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# On Vercel, set FIREBASE_SERVICE_ACCOUNT_JSON to the complete service-account JSON
# through server environment settings instead of using a local credential path.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional browser API URL. Empty uses the Vite /api proxy (recommended locally).
VITE_API_BASE_URL=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Only for isolated automated tests or temporary offline development:
# STORAGE_BACKEND=memory

# Configure locally with npm run admin:setup (writes these to the ignored .env).
# In deployment, provide these through your platform's secret environment settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# One server-only UFL connection for every model family.
# Set both variables in Vercel and redeploy. Never prefix them with VITE_.
# Use the exact gateway base URL; do not automatically add /v1.
UFL_API_KEY=
UFL_BASE_URL=https://api.ai.it.ufl.edu
# Agent sessions can also use an encrypted per-run UFL key entered in /admin.
# Evaluation models must accept images; check this in Admin > API health.
