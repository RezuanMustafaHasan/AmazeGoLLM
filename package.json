{
  "name": "amaze-go",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "emulators": "firebase emulators:start --only firestore --project demo-amazego --import .emulator-data --export-on-exit .emulator-data",
    "test": "npm run test:web && uv run pytest",
    "test:web": "vitest run src/*.test.ts",
    "levels:validate": "uv run python -m backend.scripts.levels validate",
    "levels:generate": "uv run python -m backend.scripts.levels generate",
    "levels:replace": "uv run python -m backend.scripts.levels replace",
    "levels:extract": "uv run python -m backend.scripts.extract_from_screenshots",
    "levels:migrate": "uv run python -m backend.scripts.migrate_levels",
    "admin:setup": "uv run python -m backend.scripts.setup_admin"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
